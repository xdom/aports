# Maintainer: Keon Cachia <keonfarrugia@gmail.com>

pkgname=rill
pkgver=0.6.0
pkgrel=1
pkgdesc="A minimalist scrolling window manager for River"
url="https://codeberg.org/lzj15/rill"
arch="x86_64"
license="MIT"

_zigwlver=0.6.0
_xkbver=0.4.0

depends="
	so:libxkbcommon.so.0
	wayland-libs-client
"

makedepends="
	libxkbcommon-dev
	wayland-dev
	wayland-protocols
	zig>=0.16.0
"

options="!check" # config.zig test segfaults
subpackages="$pkgname-doc"

source="
	$pkgname-$pkgver.tar.gz::https://codeberg.org/lzj15/rill/archive/$pkgver.tar.gz
	zig-wayland-$_zigwlver.tar.gz::https://codeberg.org/ifreund/zig-wayland/archive/v$_zigwlver.tar.gz
	zig-xkbcommon-$_xkbver.tar.gz::https://codeberg.org/ifreund/zig-xkbcommon/archive/v$_xkbver.tar.gz
"

build() {
	cd "$srcdir/$pkgname"
	zig build \
		-Doptimize=ReleaseSafe \
		--fork="$srcdir/zig-wayland" \
		--fork="$srcdir/zig-xkbcommon"
}

package() {
	cd "$srcdir/$pkgname"
	DESTDIR="$pkgdir" zig build \
		-Doptimize=ReleaseSafe \
		--fork="$srcdir/zig-wayland" \
		--fork="$srcdir/zig-xkbcommon" \
		--prefix usr/ \
		install
	install -Dm644 LICENSE \
		"$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	install -Dm644 config.zon \
		"$pkgdir/usr/share/doc/$pkgname/config.zon"
}


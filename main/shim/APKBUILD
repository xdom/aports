# Maintainer: nl6720 <nl6720@archlinux.org>
pkgname=shim
pkgver=16.1_p8
pkgrel=0
pkgdesc="Initial UEFI bootloader for Secure Boot environments (prebuilt signed x64 binaries from Fedora)"
url="https://src.fedoraproject.org/rpms/shim"
arch="x86_64"
license="BSD-2-Clause"

options="!strip"
makedepends="rpm2cpio"

_shim_ver=${pkgver%_p*}
_shim_rel=${pkgver##*_p}
_shim_file="shim-x64-${_shim_ver}-${_shim_rel}.x86_64.rpm"
source="
	https://kojipkgs.fedoraproject.org/packages/shim/${_shim_ver}/${_shim_rel}/x86_64/${_shim_file}
"

unpack() {
	mkdir -p "$srcdir"
	cd "$srcdir"
	rpm2cpio "$SRCDEST/${_shim_file}" | cpio -idmv
}

build() {
	:
}

package() {
	cd "$srcdir/usr/lib/efi/shim/${_shim_ver}-${_shim_rel}"

	install -Dm644 \
		EFI/fedora/shimx64.efi \
		"$pkgdir/usr/share/$pkgname/shimx64.efi"

	install -Dm644 \
		EFI/fedora/mmx64.efi \
		"$pkgdir/usr/share/$pkgname/mmx64.efi"

	install -Dm644 \
		EFI/BOOT/fbx64.efi \
		"$pkgdir/usr/share/$pkgname/fbx64.efi"
}

sha512sums="
26215953f7b01da06d0452b4287277ad5fc295a1aa4b79c1ff9d9a454fb029ae2a2090a64609d8ea42613bd5ae3e02ccebd1bea6e6912bbd5e0cd6de320723f2  shim-x64-16.1-8.x86_64.rpm
"

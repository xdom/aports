# Contributor: aaaaa <please@ignore.pl>
# Maintainer: aaaaa <please@ignore.pl>

pkgname=beansprout
pkgver=1.1.1
pkgrel=1
pkgdesc="A DWM-style tiling Wayland compositor with built-in wallpaper and clock/bar configured in KDL"
url="https://codeberg.org/beansprout/beansprout"
arch="x86_64"
license="GPL-3.0-only CC-BY-4.0 CC0-1.0"

depends="
	so:libfcft.so.4
	so:libpixman-1.so.0
	so:libxkbcommon.so.0
	wayland-libs-client
"

makedepends="
	libxkbcommon-dev
	fcft-dev
	pixman-dev
	scdoc
	wayland-dev
	wayland-protocols
	zig>=0.16.0
"

options="net"
subpackages="$pkgname-doc"

source="
	$pkgname-$pkgver.tar.gz::https://codeberg.org/beansprout/beansprout/archive/v$pkgver.tar.gz
	$pkgname.desktop
"

build() {
	cd "$srcdir/$pkgname"
	zig build -Doptimize=ReleaseSafe
}

check() {
	cd "$srcdir/$pkgname"
	zig build -Doptimize=ReleaseSafe test
}

package() {
	cd "$srcdir/$pkgname"
	DESTDIR="$pkgdir" zig build -Doptimize=ReleaseSafe --prefix usr/ install
	install -Dm644 LICENSES/GPL-3.0-only.txt \
		"$pkgdir/usr/share/licenses/$pkgname/GPL-3.0-only.txt"
	install -Dm644 LICENSES/CC-BY-4.0.txt \
		"$pkgdir/usr/share/licenses/$pkgname/CC-BY-4.0.txt"
	install -Dm644 LICENSES/CC0-1.0.txt \
		"$pkgdir/usr/share/licenses/$pkgname/CC0-1.0.txt"
	install -Dm644 examples/config.kdl \
		"$pkgdir/usr/share/doc/$pkgname/examples/config.kdl"

	cd "$srcdir"
	install -D -m644 beansprout.desktop \
		"$pkgdir/usr/share/wayland-sessions/beansprout.desktop"
}

sha512sums="
f30cfe42cff0f2bf250799074c6d2c72a65599eaf1c559b4000b27e3ed1d4ddb46d077798093b1fbad827d41024a8ff05ae11a25b7c706f2bae8e6107d7621ca  beansprout-1.1.1.tar.gz
6352b7cfca563bd40ef3820518895ba57438e93e5a8e2fa0c8fc6e7f5293310e81a26d3f9906181f2fd3e13f92c951515771b2f82a158e64811d431c4cc5c7c2  beansprout.desktop
"

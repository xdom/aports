# Contributor:
# Maintainer:
pkgname=glacier-meta
pkgver=1.1.0
pkgrel=0
pkgdesc="Glacier meta packages"
url="https://github.com/xdom/glacier-meta"
arch="noarch"
license="unknown"
depends=""
makedepends=""
checkdepends=""
install=""
subpackages="$pkgname-base $pkgname-desktop $pkgname-dev $pkgname-network $pkgname-wifi"
source=""
builddir="$srcdir/"

base() {
	depends="
		bat bottom btrfs-progs chimerautils curl docs eza fastfetch
		fd fzf man-pages neofetch neovim oh-my-zsh ripgrep sysklogd
		tar tmux wget yazi zip zsh
	"
	mkdir -p "$subpkgdir"
}

dev() {
	depends="
		alpine-sdk build-base cmake delta lazygit gdb git nodejs
		python3 rustup rust-gdb tree-sitter
	"
	mkdir -p "$subpkgdir"
}

desktop() {
	depends="
		alacritty cava emptty font-dejavu font-openmoji fuzzel
		grimshot intel-media-driver kanshi libinput libinput-udev
		linux-firmware-amdgpu mako mesa-dri-gallium mesa-va-gallium
		nerd-fonts-all
		pavucontrol pipewire pipewire-pulse
		pulseaudio-bluez pulsemixer pavucontrol seatd
		sway swaybg swayidle swaylock
		qutebrowser turnstile waybar wireplumber wl-clipboard
		xdg-desktop-portal-gtk xdg-desktop-portal-wlr
		xwayland
	"
	mkdir -p "$subpkgdir"
}

network() {
	depends="
		openconnect vpn-slice
	"
	mkdir -p "$subpkgdir"
}

wifi() {
	depends="
		iwd
	"
	mkdir -p "$subpkgdir"
}

package() {
	mkdir -p "$pkgdir"
}


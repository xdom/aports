# Contributor:
# Maintainer:
pkgname=apparmord
pkgver=0_git20250109
pkgrel=1
_commit="2560e9645ff11d4fd24c69ef8145adf9bc8f817c"
pkgdesc="Full set of apparmor profiles (complain mode)"
url="https://github.com/roddhjav/apparmor.d"
arch="x86_64"
license="GPL2"
depends="apparmor"
makedepends="
	findutils
	go
	git
	rsync
	"
subpackages="$pkgname-fsp $pkgname-enforce $pkgname-enforce-fsp:enforce_fsp"
source="$pkgname-$_commit.tar.gz::https://github.com/roddhjav/apparmor.d/archive/$_commit.tar.gz"
builddir="$srcdir/apparmor.d-$_commit"

build() {
	export CGO_CPPFLAGS="${CPPFLAGS}"
	export CGO_CFLAGS="${CFLAGS}"
	export CGO_CXXFLAGS="${CXXFLAGS}"
	export CGO_LDFLAGS="${LDFLAGS}"
	export GOFLAGS="-buildmode=pie -trimpath -ldflags=-linkmode=external -mod=readonly -modcacherw"
	make build
	mkdir .package
	cp -r .build .package/build

	DISTRIBUTION=arch .package/build/prebuild --complain
	mv .build .package/complain
	cp -r .package/build/* .package/complain/

	DISTRIBUTION=arch .package/build/prebuild --enforce
	mv .build .package/enforce
	cp -r .package/build/* .package/enforce/

	DISTRIBUTION=arch .package/build/prebuild --complain --full
	mv .build .package/complain-fsp
	cp -r .package/build/* .package/complain-fsp/

	DISTRIBUTION=arch .package/build/prebuild --enforce --full
	mv .build .package/enforce-fsp
	cp -r .package/build/* .package/enforce-fsp/
}

package() {
	make install BUILD=.package/complain DESTDIR="$pkgdir"
	# Remove systemd stuff
	rm -rf "${pkgdir}/usr/lib"
}

enforce() {
	pkgdesc="Full set of apparmor profiles (enforce mode)"
	provides="${pkgname}"

	cd "${builddir}"
	make install BUILD=.package/enforce DESTDIR="$subpkgdir"
	# Remove systemd stuff
	rm -rf "${subpkgdir}/usr/lib"
}

fsp() {
	pkgdesc="Full set of apparmor profiles with full system policy enabled (complain mode)"
	provides="${pkgname}"

	cd "${builddir}"
	make install BUILD=.package/complain-fsp DESTDIR="$subpkgdir"
	# Remove systemd stuff
	rm -rf "${subpkgdir}/usr/lib"
}

enforce_fsp() {
	pkgdesc="Full set of apparmor profiles with full system policy enabled (enforce mode)"
	provides="${pkgname}"

	cd "${builddir}"
	ls -la
	make install BUILD=.package/enforce-fsp DESTDIR="$subpkgdir"
	# Remove systemd stuff
	rm -rf "${subpkgdir}/usr/lib"
}

sha512sums="
2b09d2ad989e61eefe586ed8fd703f8df0516a6a4d6260080b6e9c5994b180430f753e2fe34a064ce3d05c0c72763cb4a3fccb983b104d39a3f5a3be47fa37c8  apparmord-2560e9645ff11d4fd24c69ef8145adf9bc8f817c.tar.gz
"
